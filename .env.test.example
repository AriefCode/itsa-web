# Contoh environment untuk menjalankan test end-to-end.
# Salin menjadi .env.test — berkas hasil salinannya TIDAK boleh di-commit.
#
#   cp .env.test.example .env.test
#
# Kenapa terpisah dari .env biasa: test e2e menanam akun admin sungguhan ke
# database lewat tests/helpers/seedUser.ts. Kalau dijalankan dengan .env yang
# menunjuk database berisi data asli, akun uji itu mendarat di sana — dan
# setiap akun yang bisa login adalah admin penuh.
#
# seedUser menolak berjalan kecuali ketiga syarat ini terpenuhi:
#   1. NODE_ENV bukan production
#   2. DATABASE_URL memakai skema file: dan menunjuk berkas lokal
#   3. nama berkasnya mengandung "test" atau "uji"

# Database uji terpisah. Berkasnya dibuat sendiri saat test pertama berjalan,
# dan aman dihapus kapan saja. Sudah tercakup .gitignore lewat pola *.db.
DATABASE_URL=file:./test.db

# Boleh sama dengan .env — hanya dipakai menandatangani sesi selama test.
# Tetap isi dengan nilai acak:  openssl rand -hex 32
PAYLOAD_SECRET=ISI_DENGAN_NILAI_ACAK

# Alamat yang dituju Playwright. Samakan dengan port server uji yang dipakai.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
