# Lokasi berkas database SQLite, relatif terhadap root proyek.
DATABASE_URL=file:./itsa-web.db

# Kunci untuk mengenkripsi token login. WAJIB diisi dan sebaiknya berbeda
# di tiap mesin. Buat nilai acak dengan:  openssl rand -hex 32
PAYLOAD_SECRET=ISI_DENGAN_NILAI_ACAK

# Dipakai untuk CORS dan pembentukan tautan. Tanpa garis miring di akhir.
# Kalau menjalankan di port selain 3000, ubah juga nilai ini, lalu hapus
# folder .next sebelum menjalankan ulang.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Kunci untuk mengautentikasi cron job.
CRON_SECRET=ISI_DENGAN_NILAI_ACAK

# Kunci untuk memvalidasi permintaan preview dari panel admin.
PREVIEW_SECRET=ISI_DENGAN_NILAI_ACAK

# Nama header yang dipercaya sebagai alamat pengunjung, dipakai untuk membatasi
# laju pengiriman aspirasi. SENGAJA KOSONG secara bawaan.
#
# Isi HANYA kalau ada proxy di depan aplikasi yang MENIMPA header tersebut:
#   x-real-ip         -> Nginx dengan  proxy_set_header X-Real-IP $remote_addr;
#   cf-connecting-ip  -> ada Cloudflare di depan Nginx
#
# Kalau dibiarkan kosong, tidak ada header yang dibaca dan semua pengunjung
# berbagi satu jatah — lebih ketat, tapi tetap aman.
#
# JANGAN diisi kalau tidak ada proxy yang menimpanya. Header yang tidak ditimpa
# dikirim langsung oleh klien, sehingga pembatasan lajunya bisa dilewati cukup
# dengan mengganti-ganti nilainya.
#
# x-forwarded-for dan forwarded DITOLAK aplikasi walau diisi di sini: keduanya
# berisi daftar beruas koma yang boleh ditambahi klien. Kalau tetap diisi, akan
# muncul peringatan saat start dan nilainya diperlakukan seolah kosong.
#
# Lihat README bagian "Deploy", termasuk smoke test setelah deploy.
TRUSTED_IP_HEADER=
